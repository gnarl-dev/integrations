{
  "name": "gnarl-ai-sdk",
  "version": "0.1.0",
  "description": "Gnarl agent memory for the Vercel AI SDK: memory tools and a recall middleware",
  "license": "Apache-2.0",
  "author": "Lucenia",
  "homepage": "https://gnarl.dev",
  "keywords": [
    "gnarl",
    "ai-sdk",
    "vercel-ai",
    "agent-memory",
    "memory",
    "llm",
    "middleware"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "ai": "^7.0.137",
    "gnarl-client": "^0.1.1",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "ai": "7.0.137",
    "gnarl-client": "0.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
